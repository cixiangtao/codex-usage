{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "hooks": {
    "before:init": "bun run typecheck",
    "before:bump": "VERSION=${version} BUILD_NUMBER=$(date +%Y%m%d%H%M%S) OUTPUT_DIR=dist bun run package:app && ditto -c -k --keepParent dist/CodexUsage.app dist/CodexUsage-v${version}.zip",
    "after:bump": "bun install --lockfile-only"
  },
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}"
  },
  "npm": {
    "publish": false
  },
  "gitlab": {
    "release": true,
    "releaseName": "CodexUsage v${version}",
    "assets": ["dist/CodexUsage-v${version}.zip"],
    "useGenericPackageRepositoryForAssets": true,
    "genericPackageRepositoryName": "codex-usage"
  }
}
